# Keep real values in Render Environment Variables only. Never commit credentials.
INTAKE_EMAIL=private-inbox@example.com
FROM_EMAIL=website@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=website@example.com
SMTP_PASS=replace-with-an-app-password

# Optional. Used to allow form submissions only from the public website origin.
PUBLIC_ORIGIN=https://example.com
