# Where website demo requests are delivered.
# Change this one value when the permanent inbox is created.
INTAKE_EMAIL=intake@aihvacmarketing.com

# Address shown as the sender. Usually this is the same mailbox as SMTP_USER.
FROM_EMAIL=website@aihvacmarketing.com

# SMTP settings supplied by the email provider.
# Example values vary by provider (Google Workspace, Zoho Mail, etc.).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=website@aihvacmarketing.com
SMTP_PASS=replace-with-an-app-password
